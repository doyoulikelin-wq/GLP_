{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://boltzgen/main/windows_gpu_handoff_20260829/ENGINEERING_EXPERIENCE_EVENT_SCHEMA.json",
  "title": "Windows GPU engineering experience staging event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "operation_id",
    "task_id",
    "attempt_id",
    "created_at_utc",
    "agent_role",
    "review_state",
    "outcome",
    "terminal_status",
    "failure_codes",
    "summary_zh",
    "lessons_zh",
    "next_adjustments_zh",
    "source_receipt_uri",
    "source_receipt_sha256",
    "code_identity",
    "input_manifest_sha256",
    "environment_manifest_sha256",
    "output_manifest_sha256",
    "supersedes_event_id",
    "formal_gate_claimed",
    "training_performed",
    "model_weights_modified",
    "lockbox_access_count"
  ],
  "properties": {
    "schema_version": {"const": "ENGINEERING_EXPERIENCE_EVENT_V1"},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "task_id": {"type": "string", "pattern": "^T(?:-1|[0-9]|1[01])$"},
    "attempt_id": {"type": "string", "pattern": "^attempt_[0-9]{3}$"},
    "created_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "agent_role": {"const": "WINDOWS_EXECUTOR"},
    "review_state": {"const": "PENDING_MAC_REVIEW"},
    "outcome": {"enum": ["SUCCESS", "FAILURE", "BLOCKED"]},
    "terminal_status": {"type": "string", "pattern": "^[A-Z][A-Z0-9_:-]{2,127}$"},
    "failure_codes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_:-]{2,127}$"},
      "uniqueItems": true
    },
    "summary_zh": {"type": "string", "minLength": 1, "maxLength": 2000},
    "lessons_zh": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 1000},
      "minItems": 1
    },
    "next_adjustments_zh": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "source_receipt_uri": {"type": "string", "pattern": "^(workspace|windows|wsl)://.+"},
    "source_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "code_identity": {"type": "string", "minLength": 1, "maxLength": 256},
    "input_manifest_sha256": {"$ref": "#/$defs/nullableSha256"},
    "environment_manifest_sha256": {"$ref": "#/$defs/nullableSha256"},
    "output_manifest_sha256": {"$ref": "#/$defs/nullableSha256"},
    "supersedes_event_id": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"}
      ]
    },
    "formal_gate_claimed": {"const": false},
    "training_performed": {"const": false},
    "model_weights_modified": {"const": false},
    "lockbox_access_count": {"const": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    }
  }
}
